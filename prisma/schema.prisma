generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Country {
  id     Int     @id @default(autoincrement())
  name   String  @db.VarChar
  states State[]
}

model State {
  id         Int     @id @default(autoincrement())
  country_id Int
  name       String  @db.VarChar
  cities     City[]
  country    Country @relation(fields: [country_id], references: [id], onDelete: Cascade)
}

model City {
  id        Int       @id @default(autoincrement())
  state_id  Int
  name      String    @db.VarChar
  addresses Address[]
  state     State     @relation(fields: [state_id], references: [id], onDelete: Cascade)
}

model Address {
  id          Int      @id @default(autoincrement())
  city_id     Int
  postal_code String   @db.VarChar
  street      String   @db.VarChar
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @updatedAt @db.Timestamptz(6)
  city        City     @relation(fields: [city_id], references: [id], onDelete: Cascade)
  board       Board?
  school      School?
}

model Board {
  id                  Int                  @id @default(autoincrement())
  name                String               @unique @db.VarChar
  abbreviation        String               @unique @db.VarChar
  address_id          Int                  @unique
  created_at          DateTime             @default(now()) @db.Timestamptz(6)
  updated_at          DateTime             @updatedAt @db.Timestamptz(6)
  address             Address              @relation(fields: [address_id], references: [id], onDelete: Cascade)
  instruction_mediums Instruction_Medium[]
  patterns            Pattern[]
  schools             School[]
  standards           Standard[]
  subjects            Subject[]
  teacher_curriculum_scopes Teacher_Curriculum_Scope[]
  exam_body           Exam_Body?
}

model Standard {
  id                       Int                       @id @default(autoincrement())
  board_id                 Int
  name                     String                    @db.VarChar
  created_at               DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                  @updatedAt @db.Timestamptz(6)
  sequence_number          Int
  chapters                 Chapter[]
  medium_standard_subjects Medium_Standard_Subject[]
  patterns                 Pattern[]
  Practice_Attempt         Practice_Attempt[]
  school_standards         School_Standard[]
  teacher_curriculum_scopes Teacher_Curriculum_Scope[]
  board                    Board                     @relation(fields: [board_id], references: [id], onDelete: Cascade)
  exam_stage               Exam_Stage?

  @@unique([board_id, name])
  @@unique([board_id, sequence_number])
}

model Subject {
  id                       Int                       @id @default(autoincrement())
  board_id                 Int
  name                     String                    @db.VarChar
  created_at               DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                  @updatedAt @db.Timestamptz(6)
  chapters                 Chapter[]
  medium_standard_subjects Medium_Standard_Subject[]
  patterns                 Pattern[]
  Practice_Attempt         Practice_Attempt[]
  board                    Board                     @relation(fields: [board_id], references: [id], onDelete: Cascade)
  teacher_subjects         Teacher_Subject[]
  teacher_curriculum_scopes Teacher_Curriculum_Scope[]
  syllabus_nodes           Syllabus_Node[]

  @@unique([board_id, name])
}

model Instruction_Medium {
  id                         Int                          @id @default(autoincrement())
  board_id                   Int
  instruction_medium         String                       @db.VarChar
  created_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime                     @updatedAt @db.Timestamptz(6)
  language_id                Int?
  html_files                 HTML_File[]
  board                      Board                        @relation(fields: [board_id], references: [id], onDelete: Cascade)
  language                   Language?                    @relation("BoardMediumLanguage", fields: [language_id], references: [id], onDelete: SetNull)
  platform_language          Language?                    @relation("PlatformLanguageMedium")
  medium_standard_subjects   Medium_Standard_Subject[]
  question_text_topics       Question_Text_Topic_Medium[]
  school_instruction_mediums School_Instruction_Medium[]

  @@unique([board_id, instruction_medium])
  @@index([language_id])
}

/// Global translation / paper languages for competitive & entrance exams.
/// Board flow keeps using Instruction_Medium (per-board); exams use Language.
model Language {
  id                     Int                  @id @default(autoincrement())
  code                   String               @unique @db.VarChar(10)
  name                   String               @unique @db.VarChar
  is_active              Boolean              @default(true)
  sequence_number        Int                  @default(1)
  /// Canonical Instruction_Medium used by QTTM / translation APIs
  instruction_medium_id  Int?                 @unique
  created_at             DateTime             @default(now()) @db.Timestamptz(6)
  updated_at             DateTime             @updatedAt @db.Timestamptz(6)
  instruction_medium     Instruction_Medium?  @relation("PlatformLanguageMedium", fields: [instruction_medium_id], references: [id], onDelete: SetNull)
  board_mediums          Instruction_Medium[] @relation("BoardMediumLanguage")
}

model School {
  id                         Int                         @id @default(autoincrement())
  board_id                   Int
  name                       String                      @db.VarChar
  address_id                 Int                         @unique
  principal_name             String                      @db.VarChar
  email                      String                      @db.VarChar
  contact_number             String                      @db.VarChar
  alternate_contact_number   String?                     @db.VarChar
  created_at                 DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime                    @updatedAt @db.Timestamptz(6)
  address                    Address                     @relation(fields: [address_id], references: [id], onDelete: Cascade)
  board                      Board                       @relation(fields: [board_id], references: [id], onDelete: Cascade)
  school_instruction_mediums School_Instruction_Medium[]
  school_standards           School_Standard[]
  test_papers                Test_Paper[]
  institution                Institution?
}

model School_Instruction_Medium {
  id                    Int                @id @default(autoincrement())
  instruction_medium_id Int
  school_id             Int
  created_at            DateTime           @default(now()) @db.Timestamptz(6)
  updated_at            DateTime           @updatedAt @db.Timestamptz(6)
  instruction_medium    Instruction_Medium @relation(fields: [instruction_medium_id], references: [id], onDelete: Cascade)
  school                School             @relation(fields: [school_id], references: [id], onDelete: Cascade)

  @@unique([school_id, instruction_medium_id])
}

model School_Standard {
  id               Int               @id @default(autoincrement())
  standard_id      Int
  school_id        Int
  created_at       DateTime          @default(now()) @db.Timestamptz(6)
  updated_at       DateTime          @updatedAt @db.Timestamptz(6)
  school           School            @relation(fields: [school_id], references: [id], onDelete: Cascade)
  standard         Standard          @relation(fields: [standard_id], references: [id], onDelete: Cascade)
  students         Student[]
  teacher_subjects Teacher_Subject[]
  learner_memberships Learner_Institution_Membership[]

  @@unique([school_id, standard_id])
}

model User {
  id                       Int                             @id @default(autoincrement())
  email_id                 String                          @unique @db.VarChar
  password                 String                          @db.VarChar
  name                     String                          @db.VarChar
  contact_number           String                          @db.VarChar
  alternate_contact_number String?                         @db.VarChar
  highest_qualification    String?                         @db.VarChar
  status                   Boolean                         @default(true)
  created_at               DateTime                        @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                        @updatedAt @db.Timestamptz(6)
  password_resets          Password_Reset[]
  student                  Student?
  teacher_subjects         Teacher_Subject[]
  teacher_curriculum_scopes Teacher_Curriculum_Scope[]
  teacher_exam_cohorts     Teacher_Exam_Cohort[]
  assigned_tests           Test_Assignment[]
  test_papers              Test_Paper[]
  user_roles               User_Role[]
  participants             Participant[]
  institution_memberships  Institution_Membership[]        @relation("MembershipUser")
  membership_responses     Institution_Membership[]        @relation("MembershipResponder")
  learner_memberships      Learner_Institution_Membership[] @relation("LearnerMembershipUser")
  learner_membership_responses Learner_Institution_Membership[] @relation("LearnerMembershipResponder")
  institutions_created     Institution[]                   @relation("InstitutionCreator")
  student_groups_created   Student_Group[]                 @relation("StudentGroupCreator")
  user_notifications       User_Notification[]
}

model Role {
  id         Int         @id @default(autoincrement())
  role_name  String      @unique @db.VarChar
  user_roles User_Role[]
}

model User_Role {
  id         Int      @id @default(autoincrement())
  user_id    Int
  role_id    Int
  created_at DateTime @default(now()) @db.Timestamptz(6)
  role       Role     @relation(fields: [role_id], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, role_id])
}

model Medium_Standard_Subject {
  id                    Int                @id @default(autoincrement())
  instruction_medium_id Int
  standard_id           Int
  subject_id            Int
  created_at            DateTime           @default(now()) @db.Timestamptz(6)
  updated_at            DateTime           @updatedAt @db.Timestamptz(6)
  instruction_medium    Instruction_Medium @relation(fields: [instruction_medium_id], references: [id], onDelete: Cascade)
  standard              Standard           @relation(fields: [standard_id], references: [id], onDelete: Cascade)
  subject               Subject            @relation(fields: [subject_id], references: [id], onDelete: Cascade)

  @@unique([instruction_medium_id, standard_id, subject_id])
}

model Teacher_Subject {
  id                  Int                          @id @default(autoincrement())
  user_id             Int
  school_standard_id  Int
  subject_id          Int
  created_at          DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at          DateTime                     @updatedAt @db.Timestamptz(6)
  student_enrollments Student_Subject_Enrollment[]
  school_standard     School_Standard              @relation(fields: [school_standard_id], references: [id], onDelete: Cascade)
  subject             Subject                      @relation(fields: [subject_id], references: [id], onDelete: Cascade)
  user                User                         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, school_standard_id, subject_id])
}

/// Free-teacher curriculum scope for creating papers (board-level; no school required).
/// Org assign still uses Teacher_Subject + L2. Scopes coexist.
model Teacher_Curriculum_Scope {
  id          Int      @id @default(autoincrement())
  user_id     Int
  board_id    Int
  standard_id Int
  subject_id  Int
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @updatedAt @db.Timestamptz(6)
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  board       Board    @relation(fields: [board_id], references: [id], onDelete: Cascade)
  standard    Standard @relation(fields: [standard_id], references: [id], onDelete: Cascade)
  subject     Subject  @relation(fields: [subject_id], references: [id], onDelete: Cascade)

  @@unique([user_id, standard_id, subject_id])
  @@index([user_id, board_id])
}

/// Teacher teaching target for coaching exam cohorts (P8 teaching graph).
model Teacher_Exam_Cohort {
  id             Int         @id @default(autoincrement())
  user_id        Int
  exam_cohort_id Int
  created_at     DateTime    @default(now()) @db.Timestamptz(6)
  updated_at     DateTime    @updatedAt @db.Timestamptz(6)
  user           User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  exam_cohort    Exam_Cohort @relation(fields: [exam_cohort_id], references: [id], onDelete: Cascade)

  @@unique([user_id, exam_cohort_id])
  @@index([exam_cohort_id])
}

model Chapter {
  id                        Int                  @id @default(autoincrement())
  sequential_chapter_number Int
  name                      String               @db.VarChar
  created_at                DateTime             @default(now()) @db.Timestamptz(6)
  updated_at                DateTime             @updatedAt @db.Timestamptz(6)
  standard_id               Int
  subject_id                Int
  standard                  Standard             @relation(fields: [standard_id], references: [id], onDelete: Cascade)
  subject                   Subject              @relation(fields: [subject_id], references: [id], onDelete: Cascade)
  Practice_Attempt          Practice_Attempt[]
  test_paper_chapters       Test_Paper_Chapter[]
  topics                    Topic[]
  syllabus_nodes            Syllabus_Node[]

  @@unique([subject_id, standard_id, sequential_chapter_number])
}

model Topic {
  id                      Int                @id @default(autoincrement())
  chapter_id              Int
  sequential_topic_number Int
  name                    String             @db.VarChar
  created_at              DateTime           @default(now()) @db.Timestamptz(6)
  updated_at              DateTime           @updatedAt @db.Timestamptz(6)
  Practice_Attempt        Practice_Attempt[]
  question_topics         Question_Topic[]
  chapter                 Chapter            @relation(fields: [chapter_id], references: [id], onDelete: Cascade)
  syllabus_nodes          Syllabus_Node[]
}

model Question_Type {
  id                        Int                              @id @default(autoincrement())
  type_name                 String                           @db.VarChar
  questions                 Question[]
  subsection_question_types Subsection_Question_Type[]
  template_section_types    Template_Section_Question_Type[]
}

model Pattern {
  id           Int          @id @default(autoincrement())
  pattern_name String       @db.VarChar
  board_id     Int
  standard_id  Int
  subject_id   Int
  total_marks  Int
  created_at   DateTime     @default(now()) @db.Timestamptz(6)
  updated_at   DateTime     @updatedAt @db.Timestamptz(6)
  board          Board           @relation(fields: [board_id], references: [id], onDelete: Cascade)
  standard       Standard        @relation(fields: [standard_id], references: [id], onDelete: Cascade)
  subject        Subject         @relation(fields: [subject_id], references: [id], onDelete: Cascade)
  sections       Section[]
  test_papers    Test_Paper[]
  paper_template Paper_Template?
}

model Section {
  id                        Int                        @id @default(autoincrement())
  pattern_id                Int
  sub_section               String?                    @db.VarChar
  section_name              String                     @db.VarChar
  total_questions           Int
  mandotory_questions       Int
  marks_per_question        Int
  created_at                DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at                DateTime                   @updatedAt @db.Timestamptz(6)
  section_number            Int
  sequence_number           Int
  pattern                   Pattern                    @relation(fields: [pattern_id], references: [id], onDelete: Cascade)
  subsection_question_types Subsection_Question_Type[]

  @@unique([pattern_id, sequence_number])
}

model Subsection_Question_Type {
  id                           Int           @id @default(autoincrement())
  section_id                   Int
  seqencial_subquestion_number Int
  question_type_id             Int
  created_at                   DateTime      @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime      @updatedAt @db.Timestamptz(6)
  question_type                Question_Type @relation(fields: [question_type_id], references: [id], onDelete: Cascade)
  section                      Section       @relation(fields: [section_id], references: [id], onDelete: Cascade)

  @@unique([section_id, seqencial_subquestion_number])
}

model Blacklisted_Token {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  expires_at DateTime
  created_at DateTime @default(now())
}

model Password_Reset {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  user_id    Int
  used       Boolean  @default(false)
  expires_at DateTime
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([token])
}

model Image {
  id                Int             @id @default(autoincrement())
  image_url         String          @db.VarChar
  created_at        DateTime        @default(now()) @db.Timestamptz(6)
  updated_at        DateTime        @updatedAt @db.Timestamptz(6)
  file_size         Int
  file_type         String          @db.VarChar
  height            Int
  original_filename String          @db.VarChar
  width             Int
  match_pairs_left  Match_Pair[]    @relation("LeftImage")
  match_pairs_right Match_Pair[]    @relation("RightImage")
  mcq_options       Mcq_Option[]
  question_texts    Question_Text[]
  question_groups   Question_Group[]
}

/// Shared stimulus (e.g. CSAT reading-comprehension passage) for 2+ linked MCQs.
model Question_Group {
  id                Int                   @id @default(autoincrement())
  group_kind        String                @default("PASSAGE_MCQ") @db.VarChar
  passage_text      String
  passage_image_id  Int?
  external_key      String?               @unique @db.VarChar
  created_at        DateTime              @default(now()) @db.Timestamptz(6)
  updated_at        DateTime              @updatedAt @db.Timestamptz(6)
  passage_image     Image?                @relation(fields: [passage_image_id], references: [id])
  questions         Question[]
  test_paper_questions Test_Paper_Question[]
}

model Question {
  id                   Int                   @id @default(autoincrement())
  question_type_id     Int
  board_question       Boolean
  question_group_id    Int?
  group_order          Int?
  created_at           DateTime              @default(now()) @db.Timestamptz(6)
  updated_at           DateTime              @updatedAt @db.Timestamptz(6)
  Practice_Answer      Practice_Answer[]
  question_type        Question_Type            @relation(fields: [question_type_id], references: [id], onDelete: Cascade)
  question_group       Question_Group?          @relation(fields: [question_group_id], references: [id], onDelete: Cascade)
  question_texts       Question_Text[]
  question_topics      Question_Topic[]
  student_answers      Student_Answer[]
  test_paper_questions Test_Paper_Question[]
  syllabus_node_links  Question_Syllabus_Node[]

  @@unique([question_group_id, group_order])
  @@index([question_group_id])
}

model Question_Text {
  id                   Int                          @id @default(autoincrement())
  question_id          Int
  image_id             Int?
  question_text        String
  created_at           DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at           DateTime                     @updatedAt @db.Timestamptz(6)
  match_pairs          Match_Pair[]
  mcq_options          Mcq_Option[]
  Practice_Answer      Practice_Answer[]
  image                Image?                       @relation(fields: [image_id], references: [id])
  question             Question                     @relation(fields: [question_id], references: [id], onDelete: Cascade)
  question_text_topics Question_Text_Topic_Medium[]
  student_answers      Student_Answer[]
  test_paper_questions Test_Paper_Question[]
}

model Question_Text_Topic_Medium {
  id                    Int                @id @default(autoincrement())
  question_text_id      Int
  question_topic_id     Int
  instruction_medium_id Int
  is_verified           Boolean            @default(false)
  created_at            DateTime           @default(now()) @db.Timestamptz(6)
  updated_at            DateTime           @updatedAt @db.Timestamptz(6)
  translation_status    String             @default("original")
  instruction_medium    Instruction_Medium @relation(fields: [instruction_medium_id], references: [id], onDelete: Cascade)
  question_text         Question_Text      @relation(fields: [question_text_id], references: [id], onDelete: Cascade)
  question_topic        Question_Topic     @relation(fields: [question_topic_id], references: [id], onDelete: Cascade)

  @@unique([question_text_id, question_topic_id, instruction_medium_id])
}

model Question_Topic {
  id                   Int                          @id @default(autoincrement())
  question_id          Int
  topic_id             Int
  created_at           DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at           DateTime                     @updatedAt @db.Timestamptz(6)
  question_text_topics Question_Text_Topic_Medium[]
  question             Question                     @relation(fields: [question_id], references: [id], onDelete: Cascade)
  topic                Topic                        @relation(fields: [topic_id], references: [id], onDelete: Cascade)

  @@unique([question_id, topic_id])
}

model Mcq_Option {
  id               Int               @id @default(autoincrement())
  question_text_id Int
  option_text      String?           @db.VarChar
  image_id         Int?
  is_correct       Boolean
  created_at       DateTime          @default(now()) @db.Timestamptz(6)
  updated_at       DateTime          @updatedAt @db.Timestamptz(6)
  image            Image?            @relation(fields: [image_id], references: [id])
  question_text    Question_Text     @relation(fields: [question_text_id], references: [id], onDelete: Cascade)
  Practice_Answer  Practice_Answer[]
  student_answers  Student_Answer[]
}

model Match_Pair {
  id               Int           @id @default(autoincrement())
  question_text_id Int
  left_text        String?       @db.VarChar
  right_text       String?       @db.VarChar
  left_image_id    Int?
  right_image_id   Int?
  created_at       DateTime      @default(now()) @db.Timestamptz(6)
  updated_at       DateTime      @updatedAt @db.Timestamptz(6)
  left_image       Image?        @relation("LeftImage", fields: [left_image_id], references: [id])
  question_text    Question_Text @relation(fields: [question_text_id], references: [id], onDelete: Cascade)
  right_image      Image?        @relation("RightImage", fields: [right_image_id], references: [id])
}

model Test_Paper {
  id                          Int                   @id @default(autoincrement())
  name                        String                @db.VarChar
  // Optional for Option C competitive/entrance papers (template-based, no school)
  exam_time                   DateTime?             @db.Time(6)
  pattern_id                  Int?
  created_at                  DateTime              @default(now()) @db.Timestamptz(6)
  school_id                   Int?
  updated_at                  DateTime              @updatedAt @db.Timestamptz(6)
  user_id                     Int
  test_paper_origin_type      TestPaperOriginType?
  duration_minutes            Int?
  instructions                String?
  is_online                   Boolean               @default(false)
  negative_marking            Boolean               @default(false)
  negative_marks_per_question Float?
  randomize_options           Boolean               @default(false)
  randomize_questions         Boolean               @default(false)
  // Option C: exam-platform links (nullable — legacy board papers keep school_id)
  exam_program_id             Int?
  exam_stage_id               Int?
  institution_id              Int?
  paper_template_id           Int?
  delivery_mode               DeliveryMode?
  // Open practice: retained for backward compatibility; new papers use creation_mode
  is_open_practice            Boolean               @default(false)
  // Provenance: who created the paper and how
  creation_mode               TestPaperCreationMode @default(TEACHER_CREATED)
  generation_policy           String?               @db.VarChar
  generation_seed             String?               @db.VarChar
  generation_request          Json?
  html_files                  HTML_File[]
  test_assignments            Test_Assignment[]
  pattern                     Pattern?              @relation(fields: [pattern_id], references: [id], onDelete: Cascade)
  school                      School?               @relation(fields: [school_id], references: [id], onDelete: Cascade)
  user                        User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  exam_program                Exam_Program?         @relation(fields: [exam_program_id], references: [id], onDelete: SetNull)
  exam_stage                  Exam_Stage?           @relation(fields: [exam_stage_id], references: [id], onDelete: SetNull)
  institution                 Institution?          @relation(fields: [institution_id], references: [id], onDelete: SetNull)
  paper_template              Paper_Template?       @relation(fields: [paper_template_id], references: [id], onDelete: SetNull)
  test_paper_chapters         Test_Paper_Chapter[]
  test_paper_questions        Test_Paper_Question[]
}

model HTML_File {
  id                    Int                @id @default(autoincrement())
  test_paper_id         Int
  content_url           String             @db.VarChar
  instruction_medium_id Int
  is_default_medium     Boolean            @default(false)
  version               Int                @default(1)
  file_size             Int?
  is_pdf                Boolean            @default(false)
  access_count          Int                @default(0)
  last_accessed         DateTime?
  created_at            DateTime           @default(now()) @db.Timestamptz(6)
  updated_at            DateTime           @updatedAt @db.Timestamptz(6)
  instruction_medium    Instruction_Medium @relation(fields: [instruction_medium_id], references: [id], onDelete: Cascade)
  test_paper            Test_Paper         @relation(fields: [test_paper_id], references: [id], onDelete: Cascade)

  @@unique([test_paper_id, instruction_medium_id])
}

model Test_Paper_Chapter {
  id            Int        @id @default(autoincrement())
  test_paper_id Int
  chapter_id    Int
  weightage     Int
  created_at    DateTime   @default(now()) @db.Timestamptz(6)
  chapter       Chapter    @relation(fields: [chapter_id], references: [id], onDelete: Cascade)
  test_paper    Test_Paper @relation(fields: [test_paper_id], references: [id], onDelete: Cascade)
}

model Test_Paper_Question {
  id                Int             @id @default(autoincrement())
  test_paper_id     Int
  question_id       Int
  question_text_id  Int
  section_id        Int
  subsection_id     Int
  question_order    Int
  marks             Float
  is_mandatory      Boolean         @default(true)
  question_group_id Int?
  group_order       Int?
  created_at        DateTime        @default(now()) @db.Timestamptz(6)
  question          Question        @relation(fields: [question_id], references: [id], onDelete: Cascade)
  question_text     Question_Text   @relation(fields: [question_text_id], references: [id], onDelete: Cascade)
  test_paper        Test_Paper      @relation(fields: [test_paper_id], references: [id], onDelete: Cascade)
  question_group    Question_Group? @relation(fields: [question_group_id], references: [id], onDelete: SetNull)

  @@unique([test_paper_id, question_id, question_text_id])
  @@index([test_paper_id, section_id, question_order])
  @@index([test_paper_id, question_group_id, group_order])
}

model Student {
  id                   Int                          @id @default(autoincrement())
  user_id              Int                          @unique
  date_of_birth        DateTime?                    @db.Date
  enrollment_date      DateTime                     @default(now()) @db.Date
  school_standard_id   Int
  status               String                       @default("active") @db.VarChar
  created_at           DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at           DateTime                     @updatedAt @db.Timestamptz(6)
  student_id           String                       @db.VarChar
  Practice_Attempt     Practice_Attempt[]
  school_standard      School_Standard              @relation(fields: [school_standard_id], references: [id], onDelete: Cascade)
  user                 User                         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  student_analytics    Student_Analytics?
  Student_Notification Student_Notification[]
  student_results      Student_Result[]
  subject_enrollments  Student_Subject_Enrollment[]
  test_assignments     Test_Assignment[]
  test_attempts        Test_Attempt[]
  participant          Participant?
  learner_memberships  Learner_Institution_Membership[]

  @@unique([student_id, school_standard_id])
}

model Student_Subject_Enrollment {
  id                 Int             @id @default(autoincrement())
  student_id         Int
  teacher_subject_id Int
  status             String          @default("pending") @db.VarChar
  request_message    String?
  teacher_response   String?
  academic_year      String          @db.VarChar
  requested_at       DateTime        @default(now()) @db.Timestamptz(6)
  responded_at       DateTime?       @db.Timestamptz(6)
  enrollment_date    DateTime?       @db.Date
  created_at         DateTime        @default(now()) @db.Timestamptz(6)
  updated_at         DateTime        @updatedAt @db.Timestamptz(6)
  student            Student         @relation(fields: [student_id], references: [id], onDelete: Cascade)
  teacher_subject    Teacher_Subject @relation(fields: [teacher_subject_id], references: [id], onDelete: Cascade)

  @@unique([student_id, teacher_subject_id])
}

model Test_Assignment {
  id                  Int                    @id @default(autoincrement())
  student_id          Int
  test_paper_id       Int
  assigned_by_user_id Int
  assigned_date       DateTime               @default(now()) @db.Timestamptz(6)
  due_date            DateTime               @db.Timestamptz(6)
  available_from      DateTime               @db.Timestamptz(6)
  max_attempts        Int                    @default(1)
  time_limit_minutes  Int?
  status              String                 @default("assigned") @db.VarChar
  assignment_source   TestAssignmentSource   @default(TEACHER_ASSIGNED)
  created_at          DateTime               @default(now()) @db.Timestamptz(6)
  updated_at          DateTime               @updatedAt @db.Timestamptz(6)
  assigned_by         User                   @relation(fields: [assigned_by_user_id], references: [id], onDelete: Cascade)
  student             Student                @relation(fields: [student_id], references: [id], onDelete: Cascade)
  test_paper          Test_Paper             @relation(fields: [test_paper_id], references: [id], onDelete: Cascade)
  test_attempts       Test_Attempt[]

  @@unique([student_id, test_paper_id])
}

model Test_Attempt {
  id                 Int              @id @default(autoincrement())
  student_id         Int
  test_assignment_id Int
  attempt_number     Int              @default(1)
  started_at         DateTime         @default(now()) @db.Timestamptz(6)
  submitted_at       DateTime?        @db.Timestamptz(6)
  time_taken_seconds Int?
  status             String           @default("in_progress") @db.VarChar
  current_question   Int?
  is_practice        Boolean          @default(false)
  // Option C: sectional timing state
  current_section_id   Int?
  section_started_at   DateTime?      @db.Timestamptz(6)
  section_timings      Json? // { [sectionId]: seconds_used }
  created_at         DateTime         @default(now()) @db.Timestamptz(6)
  updated_at         DateTime         @updatedAt @db.Timestamptz(6)
  student_answers    Student_Answer[]
  student_result     Student_Result?
  student            Student          @relation(fields: [student_id], references: [id], onDelete: Cascade)
  test_assignment    Test_Assignment  @relation(fields: [test_assignment_id], references: [id], onDelete: Cascade)
}

model Student_Answer {
  id                 Int           @id @default(autoincrement())
  test_attempt_id    Int
  question_id        Int
  question_text_id   Int
  selected_option_id Int?
  // Option C: non-MCQ answer formats (JEE NAT numeric, future descriptive)
  numeric_answer     Float?
  text_answer        String?
  is_correct         Boolean?
  marks_obtained     Float?
  time_spent_seconds Int?
  is_flagged         Boolean       @default(false)
  answered_at        DateTime      @default(now()) @db.Timestamptz(6)
  question           Question      @relation(fields: [question_id], references: [id], onDelete: Cascade)
  question_text      Question_Text @relation(fields: [question_text_id], references: [id], onDelete: Cascade)
  selected_option    Mcq_Option?   @relation(fields: [selected_option_id], references: [id])
  test_attempt       Test_Attempt  @relation(fields: [test_attempt_id], references: [id], onDelete: Cascade)

  @@unique([test_attempt_id, question_id])
}

model Student_Result {
  id                    Int          @id @default(autoincrement())
  student_id            Int
  test_attempt_id       Int          @unique
  total_questions       Int
  attempted_questions   Int
  correct_answers       Int
  wrong_answers         Int
  skipped_questions     Int
  total_marks           Float
  obtained_marks        Float
  percentage            Float
  grade                 String?      @db.VarChar
  rank_in_standard      Int?
  rank_in_cohort        Int?
  time_taken_seconds    Int
  performance_level     String       @db.VarChar
  subject_wise_scores   Json?
  section_wise_scores   Json? // { [sectionId]: { obtained, total, qualified } }
  chapter_wise_analysis Json?
  strengths             Json?
  weaknesses            Json?
  recommendations       Json?
  created_at            DateTime     @default(now()) @db.Timestamptz(6)
  updated_at            DateTime     @updatedAt @db.Timestamptz(6)
  student               Student      @relation(fields: [student_id], references: [id], onDelete: Cascade)
  test_attempt          Test_Attempt @relation(fields: [test_attempt_id], references: [id], onDelete: Cascade)
}

model Student_Analytics {
  id                   Int      @id @default(autoincrement())
  student_id           Int      @unique
  total_tests_taken    Int      @default(0)
  total_practice_tests Int      @default(0)
  average_score        Float?
  best_score           Float?
  worst_score          Float?
  last_score           Float?
  created_at           DateTime @default(now()) @db.Timestamptz(6)
  updated_at           DateTime @updatedAt @db.Timestamptz(6)
  student              Student  @relation(fields: [student_id], references: [id], onDelete: Cascade)
}

model Practice_Answer {
  id                  Int              @id @default(autoincrement())
  practice_attempt_id Int
  question_id         Int
  question_text_id    Int
  selected_option_id  Int?
  is_correct          Boolean?
  time_spent_seconds  Int?
  answered_at         DateTime         @default(now()) @db.Timestamptz(6)
  Practice_Attempt    Practice_Attempt @relation(fields: [practice_attempt_id], references: [id], onDelete: Cascade)
  Question            Question         @relation(fields: [question_id], references: [id], onDelete: Cascade)
  Question_Text       Question_Text    @relation(fields: [question_text_id], references: [id], onDelete: Cascade)
  Mcq_Option          Mcq_Option?      @relation(fields: [selected_option_id], references: [id])

  @@unique([practice_attempt_id, question_id])
}

model Practice_Attempt {
  id                 Int               @id @default(autoincrement())
  student_id         Int
  subject_id         Int
  standard_id        Int
  chapter_id         Int?
  topic_id           Int?
  total_questions    Int
  started_at         DateTime          @default(now()) @db.Timestamptz(6)
  completed_at       DateTime?         @db.Timestamptz(6)
  time_taken_seconds Int?
  score_percentage   Float?
  correct_answers    Int?
  wrong_answers      Int?
  skipped_answers    Int?
  created_at         DateTime          @default(now()) @db.Timestamptz(6)
  Practice_Answer    Practice_Answer[]
  Chapter            Chapter?          @relation(fields: [chapter_id], references: [id])
  Standard           Standard          @relation(fields: [standard_id], references: [id], onDelete: Cascade)
  Student            Student           @relation(fields: [student_id], references: [id], onDelete: Cascade)
  Subject            Subject           @relation(fields: [subject_id], references: [id], onDelete: Cascade)
  Topic              Topic?            @relation(fields: [topic_id], references: [id])
}

model Student_Notification {
  id         Int       @id @default(autoincrement())
  student_id Int
  title      String    @db.VarChar
  message    String
  type       String    @db.VarChar
  priority   String    @default("normal") @db.VarChar
  is_read    Boolean   @default(false)
  action_url String?   @db.VarChar
  expires_at DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  Student    Student   @relation(fields: [student_id], references: [id], onDelete: Cascade)
}

enum TestPaperOriginType {
  board
  other
  both
}

// ============================================================
// OPTION C — EXAM PLATFORM CORE
// Exam-first taxonomy. BOARD is one category; legacy tables
// (Board, Standard, Pattern, Chapter, Topic, School, Student)
// are linked FROM the new tables so existing flows keep working.
// ============================================================

enum ExamCategoryType {
  BOARD
  ENTRANCE
  COMPETITIVE
}

enum ExamBodyJurisdiction {
  NATIONAL
  STATE
  INSTITUTIONAL
}

enum InstitutionType {
  SCHOOL
  COACHING_CENTER
  VIRTUAL
}

enum InstitutionVisibility {
  PUBLIC
  PRIVATE
}

enum OrgMemberRole {
  ADMIN
  TEACHER
}

enum OrgMembershipStatus {
  pending
  active
  rejected
  left
}

enum ParticipantType {
  SCHOOL_STUDENT
  INSTITUTE_STUDENT
  ASPIRANT
}

enum DeliveryMode {
  OFFLINE_PDF
  ONLINE_MCQ
  ONLINE_MIXED
}

enum TestPaperCreationMode {
  TEACHER_CREATED
  STUDENT_SMART
  LEGACY_OPEN_PRACTICE
}

enum TestAssignmentSource {
  TEACHER_ASSIGNED
  SELF_SMART
  LEGACY_PRACTICE_START
}

enum SyllabusNodeType {
  SECTION
  SUBJECT
  CHAPTER
  TOPIC
}

enum AnswerFormat {
  MCQ
  NUMERIC
  TEXT
  MATCH_PAIR
}

model Exam_Category {
  id          Int              @id @default(autoincrement())
  code        ExamCategoryType @unique
  name        String           @db.VarChar
  description String?
  created_at  DateTime         @default(now()) @db.Timestamptz(6)
  updated_at  DateTime         @updatedAt @db.Timestamptz(6)
  exam_bodies Exam_Body[]
}

model Exam_Body {
  id               Int            @id @default(autoincrement())
  exam_category_id Int
  name             String         @unique @db.VarChar
  abbreviation     String         @unique @db.VarChar
  logo_url         String?        @db.VarChar
  is_active        Boolean                @default(true)
  jurisdiction     ExamBodyJurisdiction?
  // Legacy link: a school board (e.g. MSBSHSE) maps 1:1 to an Exam_Body
  board_id         Int?                   @unique
  created_at       DateTime               @default(now()) @db.Timestamptz(6)
  updated_at       DateTime               @updatedAt @db.Timestamptz(6)
  exam_category    Exam_Category          @relation(fields: [exam_category_id], references: [id], onDelete: Cascade)
  board            Board?                 @relation(fields: [board_id], references: [id], onDelete: SetNull)
  exam_programs    Exam_Program[]

  @@index([exam_category_id, is_active])
}

model Exam_Program {
  id                       Int                   @id @default(autoincrement())
  exam_body_id             Int
  name                     String                @db.VarChar
  code                     String                @unique @db.VarChar
  description              String?
  default_duration_minutes Int?
  has_negative_marking     Boolean               @default(false)
  negative_marks_ratio     Float? // e.g. 0.33 for UPSC (1/3 negative)
  is_active                Boolean               @default(true)
  created_at               DateTime              @default(now()) @db.Timestamptz(6)
  updated_at               DateTime              @updatedAt @db.Timestamptz(6)
  exam_body                Exam_Body             @relation(fields: [exam_body_id], references: [id], onDelete: Cascade)
  exam_stages              Exam_Stage[]
  syllabus_nodes           Syllabus_Node[]
  paper_templates          Paper_Template[]
  institution_programs     Institution_Program[]
  exam_cohorts             Exam_Cohort[]
  participant_programs     Participant_Program[]
  test_papers              Test_Paper[]

  @@unique([exam_body_id, name])
  @@index([exam_body_id, is_active])
}

model Exam_Stage {
  id              Int              @id @default(autoincrement())
  exam_program_id Int
  name            String           @db.VarChar
  sequence_number Int
  is_qualifying   Boolean          @default(false) // e.g. UPSC CSAT: qualifying only
  qualifying_pct  Float? // e.g. 33.0 for CSAT
  // Legacy link: board "Class 10/12" standards map to stages
  standard_id     Int?             @unique
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime         @updatedAt @db.Timestamptz(6)
  exam_program    Exam_Program     @relation(fields: [exam_program_id], references: [id], onDelete: Cascade)
  standard        Standard?        @relation(fields: [standard_id], references: [id], onDelete: SetNull)
  syllabus_nodes  Syllabus_Node[]
  paper_templates Paper_Template[]
  test_papers     Test_Paper[]

  @@unique([exam_program_id, name])
  @@unique([exam_program_id, sequence_number])
}

model Syllabus_Node {
  id                Int                     @id @default(autoincrement())
  exam_program_id   Int
  exam_stage_id     Int?
  parent_id         Int?
  node_type         SyllabusNodeType
  name              String                  @db.VarChar
  sequence_number   Int                     @default(1)
  // Legacy links: board Subject/Chapter/Topic map onto syllabus nodes
  legacy_subject_id Int?
  legacy_chapter_id Int?
  legacy_topic_id   Int?
  created_at        DateTime                @default(now()) @db.Timestamptz(6)
  updated_at        DateTime                @updatedAt @db.Timestamptz(6)
  exam_program      Exam_Program            @relation(fields: [exam_program_id], references: [id], onDelete: Cascade)
  exam_stage        Exam_Stage?             @relation(fields: [exam_stage_id], references: [id], onDelete: SetNull)
  parent            Syllabus_Node?          @relation("SyllabusTree", fields: [parent_id], references: [id], onDelete: Cascade)
  children          Syllabus_Node[]         @relation("SyllabusTree")
  legacy_subject    Subject?                @relation(fields: [legacy_subject_id], references: [id], onDelete: SetNull)
  legacy_chapter    Chapter?                @relation(fields: [legacy_chapter_id], references: [id], onDelete: SetNull)
  legacy_topic      Topic?                  @relation(fields: [legacy_topic_id], references: [id], onDelete: SetNull)
  question_links    Question_Syllabus_Node[]
  template_sections Template_Section[]

  @@index([exam_program_id, node_type])
  @@index([parent_id])
}

// Tags questions to competitive/entrance syllabus nodes.
// Board questions stay linked through Question_Topic; this junction
// lets one question serve both board and competitive papers.
model Question_Syllabus_Node {
  id               Int           @id @default(autoincrement())
  question_id      Int
  syllabus_node_id Int
  created_at       DateTime      @default(now()) @db.Timestamptz(6)
  question         Question      @relation(fields: [question_id], references: [id], onDelete: Cascade)
  syllabus_node    Syllabus_Node @relation(fields: [syllabus_node_id], references: [id], onDelete: Cascade)

  @@unique([question_id, syllabus_node_id])
  @@index([syllabus_node_id])
}

model Paper_Template {
  id                Int                @id @default(autoincrement())
  exam_program_id   Int
  exam_stage_id     Int?
  name              String             @db.VarChar
  total_marks       Int
  total_questions   Int?
  duration_minutes  Int?
  delivery_mode     DeliveryMode       @default(ONLINE_MCQ)
  // Scoring config (template level)
  negative_marking  Boolean            @default(false)
  negative_marks_ratio Float? // fraction of question marks deducted per wrong answer
  nat_tolerance     Float? // +/- tolerance for numeric (NAT) answers
  is_active         Boolean            @default(true)
  // Legacy link: board Pattern maps 1:1 to a Paper_Template
  legacy_pattern_id Int?               @unique
  created_at        DateTime           @default(now()) @db.Timestamptz(6)
  updated_at        DateTime           @updatedAt @db.Timestamptz(6)
  exam_program      Exam_Program       @relation(fields: [exam_program_id], references: [id], onDelete: Cascade)
  exam_stage        Exam_Stage?        @relation(fields: [exam_stage_id], references: [id], onDelete: SetNull)
  legacy_pattern    Pattern?           @relation(fields: [legacy_pattern_id], references: [id], onDelete: SetNull)
  sections          Template_Section[]
  test_papers       Test_Paper[]

  @@unique([exam_program_id, name])
}

model Template_Section {
  id                          Int                              @id @default(autoincrement())
  paper_template_id           Int
  name                        String                           @db.VarChar
  sequence_number             Int
  total_questions             Int
  mandatory_questions         Int
  marks_per_question          Float
  // Sectional rules (Banking / CSAT style)
  time_limit_minutes          Int? // sectional timing; null = no per-section timer
  qualifying_marks            Float? // sectional cutoff; null = no cutoff
  negative_marks_per_question Float? // overrides template-level negative marking
  answer_format               AnswerFormat                     @default(MCQ)
  // Optionally scope a section to a syllabus subtree (e.g. "Reasoning")
  syllabus_node_id            Int?
  created_at                  DateTime                         @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime                         @updatedAt @db.Timestamptz(6)
  paper_template              Paper_Template                   @relation(fields: [paper_template_id], references: [id], onDelete: Cascade)
  syllabus_node               Syllabus_Node?                   @relation(fields: [syllabus_node_id], references: [id], onDelete: SetNull)
  question_types              Template_Section_Question_Type[]

  @@unique([paper_template_id, sequence_number])
}

model Template_Section_Question_Type {
  id                  Int              @id @default(autoincrement())
  template_section_id Int
  question_type_id    Int
  sequence_number     Int              @default(1)
  created_at          DateTime         @default(now()) @db.Timestamptz(6)
  template_section    Template_Section @relation(fields: [template_section_id], references: [id], onDelete: Cascade)
  question_type       Question_Type    @relation(fields: [question_type_id], references: [id], onDelete: Cascade)

  @@unique([template_section_id, question_type_id])
}

model Institution {
  id                   Int                             @id @default(autoincrement())
  institution_type     InstitutionType
  name                 String                          @db.VarChar
  email                String?                         @db.VarChar
  contact_number       String?                         @db.VarChar
  principal_name       String?                         @db.VarChar
  is_active            Boolean                         @default(true)
  org_code             String                          @unique @db.VarChar(32)
  visibility           InstitutionVisibility           @default(PRIVATE)
  closed_at            DateTime?                       @db.Timestamptz(6)
  created_by_user_id   Int?
  // Legacy link: existing School maps 1:1 to an Institution
  school_id            Int?                            @unique
  created_at           DateTime                        @default(now()) @db.Timestamptz(6)
  updated_at           DateTime                        @updatedAt @db.Timestamptz(6)
  school               School?                         @relation(fields: [school_id], references: [id], onDelete: SetNull)
  created_by           User?                           @relation("InstitutionCreator", fields: [created_by_user_id], references: [id], onDelete: SetNull)
  institution_programs Institution_Program[]
  exam_cohorts         Exam_Cohort[]
  student_groups       Student_Group[]
  participants         Participant[]
  test_papers          Test_Paper[]
  memberships          Institution_Membership[]
  learner_memberships  Learner_Institution_Membership[]

  @@index([visibility, is_active])
  @@index([institution_type, is_active])
}

/// Teacher/staff affiliation to a School or Coaching Center (L1).
model Institution_Membership {
  id                   Int                 @id @default(autoincrement())
  user_id              Int
  institution_id       Int
  member_role          OrgMemberRole       @default(TEACHER)
  status               OrgMembershipStatus @default(pending)
  request_message      String?
  responded_by_user_id Int?
  requested_at         DateTime            @default(now()) @db.Timestamptz(6)
  responded_at         DateTime?           @db.Timestamptz(6)
  created_at           DateTime            @default(now()) @db.Timestamptz(6)
  updated_at           DateTime            @updatedAt @db.Timestamptz(6)
  user                 User                @relation("MembershipUser", fields: [user_id], references: [id], onDelete: Cascade)
  institution          Institution         @relation(fields: [institution_id], references: [id], onDelete: Cascade)
  responded_by         User?               @relation("MembershipResponder", fields: [responded_by_user_id], references: [id], onDelete: SetNull)

  @@index([user_id, status])
  @@index([institution_id, status])
  @@index([institution_id, member_role, status])
}

/// Student / coaching-aspirant affiliation to an org (L1).
model Learner_Institution_Membership {
  id                   Int                 @id @default(autoincrement())
  user_id              Int
  institution_id       Int
  student_id           Int?
  participant_id       Int?
  school_standard_id   Int?
  status               OrgMembershipStatus @default(pending)
  request_message      String?
  responded_by_user_id Int?
  requested_at         DateTime            @default(now()) @db.Timestamptz(6)
  responded_at         DateTime?           @db.Timestamptz(6)
  created_at           DateTime            @default(now()) @db.Timestamptz(6)
  updated_at           DateTime            @updatedAt @db.Timestamptz(6)
  user                 User                @relation("LearnerMembershipUser", fields: [user_id], references: [id], onDelete: Cascade)
  institution          Institution         @relation(fields: [institution_id], references: [id], onDelete: Cascade)
  student              Student?            @relation(fields: [student_id], references: [id], onDelete: SetNull)
  participant          Participant?        @relation(fields: [participant_id], references: [id], onDelete: SetNull)
  school_standard      School_Standard?    @relation(fields: [school_standard_id], references: [id], onDelete: SetNull)
  responded_by         User?               @relation("LearnerMembershipResponder", fields: [responded_by_user_id], references: [id], onDelete: SetNull)

  @@index([user_id, status])
  @@index([institution_id, status])
  @@index([student_id])
  @@index([participant_id])
}

/// In-app notifications for any user (teachers, students, aspirants).
model User_Notification {
  id         Int       @id @default(autoincrement())
  user_id    Int
  title      String    @db.VarChar
  message    String
  type       String    @db.VarChar
  priority   String    @default("normal") @db.VarChar
  is_read    Boolean   @default(false)
  action_url String?   @db.VarChar
  expires_at DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_read])
}

model Institution_Program {
  id              Int          @id @default(autoincrement())
  institution_id  Int
  exam_program_id Int
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  institution     Institution  @relation(fields: [institution_id], references: [id], onDelete: Cascade)
  exam_program    Exam_Program @relation(fields: [exam_program_id], references: [id], onDelete: Cascade)

  @@unique([institution_id, exam_program_id])
}

model Exam_Cohort {
  id              Int           @id @default(autoincrement())
  exam_program_id Int
  institution_id  Int?
  name            String        @db.VarChar
  academic_year   String?       @db.VarChar
  start_date      DateTime?     @db.Date
  end_date        DateTime?     @db.Date
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @updatedAt @db.Timestamptz(6)
  exam_program    Exam_Program  @relation(fields: [exam_program_id], references: [id], onDelete: Cascade)
  institution     Institution?  @relation(fields: [institution_id], references: [id], onDelete: SetNull)
  participants    Participant[]
  teacher_mappings Teacher_Exam_Cohort[]

  @@unique([exam_program_id, name])
}

/// Named learner batch within an org. One participant may belong to many groups.
model Student_Group {
  id                 Int                    @id @default(autoincrement())
  institution_id     Int
  name               String                 @db.VarChar
  description        String?                @db.VarChar
  created_by_user_id Int?
  created_at         DateTime               @default(now()) @db.Timestamptz(6)
  updated_at         DateTime               @updatedAt @db.Timestamptz(6)
  institution        Institution            @relation(fields: [institution_id], references: [id], onDelete: Cascade)
  created_by         User?                  @relation("StudentGroupCreator", fields: [created_by_user_id], references: [id], onDelete: SetNull)
  members            Student_Group_Member[]

  @@unique([institution_id, name])
  @@index([institution_id])
}

model Student_Group_Member {
  id               Int           @id @default(autoincrement())
  student_group_id Int
  participant_id   Int
  created_at       DateTime      @default(now()) @db.Timestamptz(6)
  student_group    Student_Group @relation(fields: [student_group_id], references: [id], onDelete: Cascade)
  participant      Participant   @relation(fields: [participant_id], references: [id], onDelete: Cascade)

  @@unique([student_group_id, participant_id])
  @@index([participant_id])
}

model Participant {
  id                   Int                   @id @default(autoincrement())
  user_id              Int
  participant_type     ParticipantType
  institution_id       Int?
  exam_cohort_id       Int?
  registration_code    String?               @unique @db.VarChar
  status               String                @default("active") @db.VarChar
  // Legacy link: existing school Student maps 1:1 to a Participant
  student_id           Int?                  @unique
  created_at           DateTime              @default(now()) @db.Timestamptz(6)
  updated_at           DateTime              @updatedAt @db.Timestamptz(6)
  user                 User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  institution          Institution?          @relation(fields: [institution_id], references: [id], onDelete: SetNull)
  exam_cohort          Exam_Cohort?          @relation(fields: [exam_cohort_id], references: [id], onDelete: SetNull)
  student              Student?              @relation(fields: [student_id], references: [id], onDelete: SetNull)
  participant_programs Participant_Program[]
  learner_memberships  Learner_Institution_Membership[]
  group_memberships    Student_Group_Member[]

  @@unique([user_id, participant_type])
}

model Participant_Program {
  id              Int          @id @default(autoincrement())
  participant_id  Int
  exam_program_id Int
  enrolled_at     DateTime     @default(now()) @db.Timestamptz(6)
  participant     Participant  @relation(fields: [participant_id], references: [id], onDelete: Cascade)
  exam_program    Exam_Program @relation(fields: [exam_program_id], references: [id], onDelete: Cascade)

  @@unique([participant_id, exam_program_id])
}
